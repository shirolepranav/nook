<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- D30: one window in v1.0. The generated manifest turns multiple windows on. Multiple windows are P15. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- C-05: asked the first time Add Item opens the camera (D15, D37). -->
	<key>NSCameraUsageDescription</key>
	<string>Nook uses the camera to photograph your things. Photos stay on this device.</string>
	<!-- L-01: warm canvas with the Nook mark. LaunchBackground is generated from 03 (export_colorsets.py). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
</dict>
</plist>
